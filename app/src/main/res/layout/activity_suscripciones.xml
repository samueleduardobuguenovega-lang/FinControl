<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".suscripciones.SuscripcionesActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_subs"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:title="@string/subs_titulo"
        android:titleTextColor="?attr/colorOnSurface"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_subs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_suscripcion" />

        <!-- Estado vacío: un TextView, así su visibilidad mueve icono y mensaje juntos. -->
        <TextView
            android:id="@+id/tv_sin_subs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:drawableTop="@drawable/ic_empty_subs"
            android:drawablePadding="16dp"
            android:drawableTint="?attr/colorOutline"
            android:gravity="center"
            android:text="@string/sin_subs"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_nueva_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/sub_nueva"
            android:text="@string/sub_nueva"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/ic_add"
            app:iconTint="?attr/colorOnPrimary" />
    </FrameLayout>
</LinearLayout>
